NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/collecto?schema=public
# Must be a different database from DATABASE_URL: tests wipe and reseed it
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/collecto_test?schema=public
# At least 32 characters. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000
# Set to true when running behind a reverse proxy/load balancer, otherwise every client shares the proxy's IP
# for rate limiting
TRUST_PROXY=false
APP_TZ=Asia/Colombo
# Optional demo-date override (YYYY-MM-DD)
APP_TODAY=
LOG_LEVEL=info
UPLOADS_DIR=./uploads
UPLOADS_PUBLIC_URL=http://localhost:4000/uploads
OVERDUE_ALERTS_ENABLED=true
OVERDUE_CRON=0 8 * * *
# Max connections in the database pool
DB_POOL_MAX=10
# Payments older than this many days are summarised per item in /bootstrap (0 = send everything)
BOOTSTRAP_PAYMENT_DAYS=90
# Swagger UI at /api/docs. Defaults to true outside production
DOCS_ENABLED=
