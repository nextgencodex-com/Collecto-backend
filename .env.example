NODE_ENV=development
PORT=4000
# Pool size: append ?connection_limit=10 (Prisma reads it from the URL)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/collecto?schema=public
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/collecto_test?schema=public
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=false
APP_TZ=Asia/Colombo
# Optional demo-date override (YYYY-MM-DD)
APP_TODAY=
LOG_LEVEL=info
UPLOADS_DIR=./uploads
UPLOADS_PUBLIC_URL=http://localhost:4000/uploads
OVERDUE_ALERTS_ENABLED=true
OVERDUE_CRON=0 8 * * *
