generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  RIDER
}

enum Freq {
  WEEKLY
  MONTHLY
}

enum PaymentStatus {
  COMPLETED
  CORRECTED
}

enum NotifType {
  PAYMENT
  OVERDUE
  CLOSING
  SYSTEM
}

/// Owner (exactly one, enforced by a partial unique index in the migration) and riders.
model User {
  id            Int            @id @default(autoincrement())
  role          Role
  username      String         @unique
  email         String?        @unique
  passwordHash  String
  name          String
  phone         String?        @unique
  /// Riders only
  area          String?
  /// Relative path under UPLOADS_DIR (random file name)
  photoPath     String?
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]
  customers     Customer[]
  items         Item[]
  payments      Payment[]
  closings      Closing[]
  extensions    Extension[]
  notifications Notification[]
  audits        AuditEntry[]

  @@index([role, active])
}

model RefreshToken {
  id         Int       @id @default(autoincrement())
  userId     Int
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  /// Rotation family: reuse of a revoked token revokes the whole family
  familyId   String
  persistent Boolean   @default(false)
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
}

/// Single-row table (id = 1)
model Shop {
  id      Int    @id @default(1)
  name    String
  phone   String
  address String
}

model Product {
  code     String  @id
  name     String
  purchase Decimal @db.Decimal(12, 2)
  cash     Decimal @db.Decimal(12, 2)
  price    Decimal @db.Decimal(12, 2)
  freq     Freq
  amount   Decimal @db.Decimal(12, 2)
  period   Int
  stock    Int     @default(0)
  sold     Int     @default(0)
  items    Item[]
}

model Customer {
  id         Int         @id @default(autoincrement())
  name       String
  nic        String      @unique
  phone      String
  address    String
  city       String
  riderId    Int
  rider      User        @relation(fields: [riderId], references: [id])
  lat        Float
  lng        Float
  notes      String      @default("")
  photoPath  String?
  since      DateTime    @db.Date
  createdAt  DateTime    @default(now())
  items      Item[]
  payments   Payment[]
  extensions Extension[]

  @@index([riderId])
  @@index([name])
}

/// One instalment plan sold to a customer
model Item {
  id         Int       @id @default(autoincrement())
  customerId Int
  customer   Customer  @relation(fields: [customerId], references: [id])
  riderId    Int
  rider      User      @relation(fields: [riderId], references: [id])
  code       String
  product    Product   @relation(fields: [code], references: [code])
  /// Snapshot of the product name at sale time
  name       String
  price      Decimal   @db.Decimal(12, 2)
  freq       Freq
  amount     Decimal   @db.Decimal(12, 2)
  period     Int
  start      DateTime  @db.Date
  createdAt  DateTime  @default(now())
  payments   Payment[]

  @@index([customerId])
  @@index([riderId])
}

model Payment {
  id         Int           @id @default(autoincrement())
  /// e.g. TX261013-0007
  txn        String        @unique
  itemId     Int
  item       Item          @relation(fields: [itemId], references: [id])
  customerId Int
  customer   Customer      @relation(fields: [customerId], references: [id])
  riderId    Int
  rider      User          @relation(fields: [riderId], references: [id])
  amount     Decimal       @db.Decimal(12, 2)
  date       DateTime      @db.Date
  /// "HH:mm", as the UI displays it
  time       String
  status     PaymentStatus @default(COMPLETED)
  createdAt  DateTime      @default(now())

  @@index([itemId])
  @@index([date, riderId])
  @@index([customerId, date])
}

model AuditEntry {
  id     Int      @id @default(autoincrement())
  at     DateTime @default(now())
  userId Int?
  user   User?    @relation(fields: [userId], references: [id])
  action String
  txn    String
  /// Customer name at the time of the action
  ref    String
  old    String
  nw     String
  reason String

  @@index([at])
}

/// Owner-specific notifications
model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotifType
  title     String
  text      String
  at        DateTime  @default(now())
  read      Boolean   @default(false)
  /// Makes automatic alerts idempotent, e.g. "overdue:C101:2026-11-05"
  dedupeKey String?

  @@unique([userId, dedupeKey])
  @@index([userId, read, at])
}

model Closing {
  id        Int      @id @default(autoincrement())
  riderId   Int
  rider     User     @relation(fields: [riderId], references: [id])
  date      DateTime @db.Date
  time      String
  expected  Decimal  @db.Decimal(12, 2)
  collected Decimal  @db.Decimal(12, 2)
  pending   Decimal  @db.Decimal(12, 2)
  cash      Decimal  @db.Decimal(12, 2)
  count     Int
  note      String   @default("")

  @@unique([riderId, date])
}

model Extension {
  id         Int      @id @default(autoincrement())
  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id])
  riderId    Int
  rider      User     @relation(fields: [riderId], references: [id])
  date       DateTime @db.Date
  time       String
  until      DateTime @db.Date
  reason     String

  @@index([customerId, until])
}
